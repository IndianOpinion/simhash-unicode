{
    "name": "indianopinion/simhash-unicode",
    "description": "64-bit simhash for short text in any script: Unicode-aware tokens, Indic syllables kept whole, empty input reported as empty, Hamming distance and near-duplicate search.",
    "type": "library",
    "license": "MIT",
    "keywords": ["simhash", "near-duplicate", "unicode", "indic", "hamming", "deduplication", "fingerprint"],
    "homepage": "https://github.com/IndianOpinion/simhash-unicode",
    "support": {
        "issues": "https://github.com/IndianOpinion/simhash-unicode/issues",
        "source": "https://github.com/IndianOpinion/simhash-unicode",
        "email": "hello@indianopinion.org"
    },
    "authors": [
        {
            "name": "Indian Opinion",
            "email": "hello@indianopinion.org",
            "homepage": "https://indianopinion.org"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-mbstring": "*",
        "ext-pcre": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "suggest": {
        "ext-intl": "Needed for NFC and NFKC normalisation and used for grapheme segmentation. Without it, normalisation is skipped and every fingerprint is flagged."
    },
    "autoload": {
        "psr-4": {
            "IndianOpinion\\Simhash\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IndianOpinion\\Simhash\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress",
        "lint": "phpcs",
        "check": ["@lint", "@analyse", "@test"]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
